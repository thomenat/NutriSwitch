## USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup)
## Never commit a real key to git.
FDC_API_KEY=

## Unsplash (https://unsplash.com/developers) – recipe stock photos. Demo: 50 req/h.
UNSPLASH_ACCESS_KEY=

## Supabase (free tier)
## Used for public recipe image uploads via signed URLs (server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=recipe-images

